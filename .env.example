# Copy to .env (git-ignored) and fill in. Spring loads it on startup.
DB_URL=jdbc:postgresql://localhost:5433/splitter
DB_USER=splitter
DB_PASSWORD=splitter

# At least 256 bits, Base64-encoded. Generate with: openssl rand -base64 32
JWT_SECRET=

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
